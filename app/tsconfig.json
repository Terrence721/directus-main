{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": ["vite/client"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue"],
	"exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
