{
	"extends": ["stylelint-config-standard", "stylelint-config-standard-scss", "stylelint-config-standard-vue"],
	"plugins": ["stylelint-use-logical"],
	"overrides": [
		{
			"files": ["**/*.html", "**/*.vue"],
			"customSyntax": "postcss-html"
		}
	],
	"rules": {
		"csstools/use-logical": true
	}
}
