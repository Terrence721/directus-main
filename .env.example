# Copy to .env and fill in. Generate KEY/SECRET with:
#   node -e "const c=require('crypto');console.log('KEY='+c.randomBytes(32).toString('base64'));console.log('SECRET='+c.randomBytes(16).toString('base64'))"
KEY=
SECRET=

