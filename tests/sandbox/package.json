{
	"name": "@directus/sandbox",
	"version": "0.0.0",
	"description": "Toolkit for spinning up directus test environments",
	"homepage": "https://github.com/Terrence721/directus-main#readme",
	"scripts": {
		"cli": "tsx src/cli.ts",
		"build": "tsdown src/index.ts src/cli.ts --dts --unbundle && copyfiles src/docker/*.yml dist -u 1",
		"dev": "tsdown -w",
		"build:tests": "tsdown src/index.ts  --format=esm",
		"docs": "typedoc --plugin typedoc-plugin-markdown --out ./docs"
	},
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"bin": "dist/cli.js",
	"files": [
		"dist",
		"docker"
	],
	"keywords": [],
	"type": "module",
	"author": "Terrence Daniels <terrence_daniels_35@yahoo.com>",
	"license": "MIT",
	"private": true,
	"packageManager": "yarn@4.18.0",
	"dependencies": {
		"@directus/tsconfig": "catalog:",
		"@directus/types": "workspace:*",
		"@directus/utils": "workspace:*",
		"@types/lodash-es": "catalog:",
		"@types/node": "catalog:",
		"chalk": "catalog:",
		"commander": "catalog:",
		"copyfiles": "catalog:",
		"get-port": "catalog:",
		"knex": "catalog:",
		"lodash-es": "catalog:",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"typedoc": "catalog:",
		"typedoc-plugin-markdown": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"optionalDependencies": {
		"mysql2": "catalog:",
		"oracledb": "catalog:",
		"pg": "catalog:",
		"sqlite3": "catalog:",
		"tedious": "catalog:"
	}
}
