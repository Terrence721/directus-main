{
	"name": "@directus/sandbox",
	"version": "0.0.0",
	"description": "Toolkit for spinning up directus test environments",
	"homepage": "https://github.com/Terrence721/directus-main#readme",
	"scripts": {
		"cli": "tsx src/cli.ts",
		"build": "tsdown src/index.ts src/cli.ts --dts --unbundle && copyfiles src/docker/*.yml dist -u 1",
		"dev": "tsdown -w",
		"build:tests": "tsdown src/index.ts  --format=esm",
		"docs": "typedoc --plugin typedoc-plugin-markdown --out ./docs"
	},
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"bin": "dist/cli.js",
	"files": [
		"dist",
		"docker"
	],
	"keywords": [],
	"type": "module",
	"author": "Terrence Daniels <terrence_daniels_35@yahoo.com>",
	"license": "MIT",
	"private": true,
	"packageManager": "yarn@4.18.0",
	"dependencies": {
		"@directus/tsconfig": "4.0.0",
		"@directus/types": "workspace:*",
		"@directus/utils": "workspace:*",
		"@types/lodash-es": "4.17.12",
		"@types/node": "22.13.14",
		"chalk": "5.6.2",
		"commander": "14.0.2",
		"copyfiles": "2.4.1",
		"get-port": "7.1.0",
		"knex": "3.1.0",
		"lodash-es": "4.18.1",
		"tsdown": "0.15.11",
		"tsx": "4.22.4",
		"typedoc": "0.28.19",
		"typedoc-plugin-markdown": "4.8.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22"
	},
	"optionalDependencies": {
		"mysql2": "3.15.3",
		"oracledb": "6.10.0",
		"pg": "8.16.3",
		"sqlite3": "5.1.7",
		"tedious": "18.6.1"
	}
}
