		"@types/lodash-es": "4.17.12",
		"@types/node": "22.13.14",
		"fastify": "5.8.5",
		"jose": "6.2.3",
		"lodash-es": "4.18.1",
		"tsdown": "0.15.11",
		"tsx": "4.22.4",
		"typebox": "1.1.37",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22"
	}
