{
	"name": "directus-monorepo",
	"private": true,
	"homepage": "https://github.com/Terrence721/directus-main#readme",
	"type": "module",
	"workspaces": [
		"directus",
		"app",
		"api",
		"sdk",
		"packages/*",
		"tests/*"
	],
	"scripts": {
		"build": "yarn workspaces foreach -A -t run build",
		"format": "prettier --cache --check .",
		"lint": "eslint --cache .",
		"lint:style": "stylelint '**/*.{css,scss,vue}' --ignore-path .gitignore --cache",
		"test": "yarn workspaces foreach -A --exclude tests-blackbox run test",
		"test:blackbox": "rimraf ./dist && node scripts/deploy-production.mjs && yarn workspace tests-blackbox test",
		"test:coverage": "yarn workspaces foreach -A --exclude tests-blackbox run test:coverage"
	},
	"devDependencies": {
		"@changesets/cli": "2.29.7",
		"@directus/release-notes-generator": "workspace:*",
		"@eslint/js": "10.0.1",
		"eslint": "10.8.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-vue": "10.10.0",
		"globals": "16.5.0",
		"postcss-html": "1.8.0",
		"prettier": "3.6.2",
		"rimraf": "6.1.0",
		"stylelint": "17.13.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-config-standard-scss": "17.0.0",
		"stylelint-config-standard-vue": "1.0.0",
		"stylelint-use-logical": "2.1.3",
		"typescript": "5.9.3",
		"typescript-eslint": "8.66.0",
		"vue-eslint-parser": "10.4.1"
	},
	"resolutions": {
		"fast-xml-parser": "5.10.1",
		"@yarnpkg/shell/cross-spawn": "7.0.6",
		"tar": "7.5.22",
		"minimatch@9": "9.0.9",
		"express@4/path-to-regexp": "0.1.13",
		"adm-zip": "0.6.0",
		"js-yaml@4": "4.3.0"
	},
	"packageManager": "yarn@4.18.0",
	"engines": {
		"node": "26"
	}
}
