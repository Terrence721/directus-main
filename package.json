{
	"name": "directus-monorepo",
	"private": true,
	"homepage": "https://github.com/Terrence721/directus-main#readme",
	"type": "module",
	"workspaces": [
		"directus",
		"app",
		"api",
		"sdk",
		"packages/*",
		"tests/*"
	],
	"scripts": {
		"build": "yarn workspaces foreach -A -t --include directus run build",
		"format": "prettier --cache --check .",
		"lint": "eslint --cache .",
		"lint:style": "stylelint '**/*.{css,scss,vue}' --ignore-path .gitignore --cache",
		"test": "yarn workspaces foreach -A --include directus run test",
		"test:blackbox": "rimraf ./dist && node scripts/deploy-production.mjs && yarn workspace tests-blackbox test",
		"test:coverage": "yarn workspaces foreach -A --include directus run test:coverage"
	},
	"devDependencies": {
		"@changesets/cli": "catalog:",
		"@directus/release-notes-generator": "workspace:*",
		"@eslint/js": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-import-x": "catalog:",
		"eslint-plugin-vue": "catalog:",
		"globals": "catalog:",
		"postcss-html": "catalog:",
		"prettier": "catalog:",
		"rimraf": "catalog:",
		"stylelint": "catalog:",
		"stylelint-config-standard": "catalog:",
		"stylelint-config-standard-scss": "catalog:",
		"stylelint-config-standard-vue": "catalog:",
		"stylelint-use-logical": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vue-eslint-parser": "catalog:"
	},
	"resolutions": {
		"fast-xml-parser": "5.10.1",
		"@yarnpkg/shell/cross-spawn": "7.0.6",
		"tar": "7.5.22",
		"minimatch@9": "9.0.9",
		"express@4/path-to-regexp": "0.1.13",
		"adm-zip": "0.6.0",
		"js-yaml@4": "4.3.0"
	},
	"packageManager": "yarn@4.18.0",
	"engines": {
		"node": "26"
	}
}
