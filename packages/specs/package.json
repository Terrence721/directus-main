{
	"name": "@directus/specs",
	"version": "15.1.0",
	"description": "OpenAPI Specification of the Directus API",
	"homepage": "https://github.com/Terrence721/directus-main#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/Terrence721/directus-main.git",
		"directory": "packages/specs"
	},
	"funding": "https://github.com/Terrence721/directus-main?sponsor=1",
	"license": "SEE LICENSE IN license",
	"author": "Terrence Daniels <terrence_daniels_35@yahoo.com>",
	"type": "module",
	"exports": {
		".": "./index.js",
		"./package.json": "./package.json"
	},
	"main": "index.js",
	"files": [
		"dist",
		"index.d.ts",
		"index.js"
	],
	"scripts": {
		"build": "swagger-cli bundle src/openapi.yaml -o dist/openapi.json",
		"build:deref": "swagger-cli bundle src/openapi.yaml -o dist/openapi-deref.json --dereference",
		"dev": "npm-watch build",
		"validate": "swagger-cli validate src/openapi.yaml"
	},
	"dependencies": {
		"openapi3-ts": "4.5.0"
	},
	"devDependencies": {
		"npm-watch": "0.13.0",
		"swagger-cli": "4.0.4"
	},
	"watch": {
		"build": {
			"patterns": [
				"src"
			],
			"extensions": "yaml",
			"quiet": true,
			"silent": true
		}
	}
}
