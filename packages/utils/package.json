{
	"name": "@directus/utils",
	"version": "13.5.2",
	"description": "Utilities shared between the Directus packages",
	"homepage": "https://github.com/Terrence721/directus-main#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/Terrence721/directus-main.git",
		"directory": "packages/utils"
	},
	"funding": "https://github.com/Terrence721/directus-main?sponsor=1",
	"license": "MIT",
	"author": "Terrence Daniels <terrence_daniels_35@yahoo.com>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/shared/index.js",
		"./node": "./dist/node/index.js",
		"./browser": "./dist/browser/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/shared/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "yarn build:browser && yarn build:node && yarn build:shared",
		"build:browser": "tsdown browser/index.ts --tsconfig browser/tsconfig.json --out-dir dist/browser --dts",
		"build:node": "tsdown node/index.ts --tsconfig node/tsconfig.json --out-dir dist/node --dts",
		"build:shared": "tsdown shared/index.ts --tsconfig shared/tsconfig.json --out-dir dist/shared --dts",
		"dev": "concurrently \"yarn build:browser --watch\" \"yarn build:node --watch\" \"yarn build:shared --watch\"",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@directus/constants": "workspace:*",
		"@directus/system-data": "workspace:*",
		"date-fns": "4.1.0",
		"fs-extra": "11.3.2",
		"ipaddr.js": "2.4.0",
		"joi": "18.0.1",
		"js-yaml": "4.3.0",
		"lodash-es": "4.18.1",
		"micromustache": "8.0.3"
	},
	"devDependencies": {
		"@directus/errors": "workspace:*",
		"@directus/schema-builder": "workspace:*",
		"@directus/tsconfig": "4.0.0",
		"@directus/types": "workspace:*",
		"@ngneat/falso": "8.0.2",
		"@types/fs-extra": "11.0.4",
		"@types/js-yaml": "4.0.9",
		"@types/lodash-es": "4.17.12",
		"@types/node": "22.13.14",
		"@types/tmp": "0.2.6",
		"@vitest/coverage-v8": "4.1.10",
		"concurrently": "^9.0.0",
		"knex": "3.1.0",
		"tmp": "0.2.7",
		"tsdown": "0.15.11",
		"typescript": "5.9.3",
		"vitest": "4.1.10",
		"vue": "3.5.24"
	},
	"peerDependencies": {
		"vue": "3.5.24"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	}
}
