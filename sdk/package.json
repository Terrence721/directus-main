{
	"name": "@directus/sdk",
	"version": "24.0.0",
	"description": "Directus JavaScript SDK",
	"homepage": "https://github.com/Terrence721/directus-main#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/Terrence721/directus-main.git",
		"directory": "sdk"
	},
	"funding": "https://github.com/Terrence721/directus-main?sponsor=1",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "NODE_ENV=production tsdown",
		"dev": "NODE_ENV=development tsdown",
		"test": "vitest run --typecheck",
		"test:coverage": "vitest run --coverage --typecheck"
	},
	"devDependencies": {
		"@directus/system-data": "workspace:*",
		"@directus/tsconfig": "4.0.0",
		"@vitest/coverage-v8": "4.1.10",
		"tsdown": "0.15.11",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=22"
	}
}
